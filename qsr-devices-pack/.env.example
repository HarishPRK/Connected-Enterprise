# ── IT/OT Devices pack — server environment ─────────────────────────────────
# Copy to the target project root as `.env`. Loaded with dotenv {override:true}
# so these values BEAT shell variables (an empty exported AWS_ACCESS_KEY_ID in
# the shell would otherwise block the real one here).

# ── Express ──
PORT=3001

# ── AWS IoT Core (MQTT over WebSocket, SigV4) ──
IOT_ENDPOINT=alht1i2bx8tzt-ats.iot.us-east-1.amazonaws.com
IOT_REGION=us-east-1
# IOT_CLIENT_ID=ce-server-custom          # default: random ce-server-<8 chars>

# Credentials — pick ONE mechanism:
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=
# AWS_PROFILE=default
# AWS_USE_INSTANCE_ROLE=1                 # EC2 instance role (IMDS) opt-in

# ── Topics (defaults shown; override only if the gateway side changes) ──
# IOT_DEVICE_TOPICS=rdk/devices/inventory,prpl/devices/inventory
# IOT_IPSEC_TOPICS=rdk/ipsec/metrics,prpl/ipsec/metrics   # Wi-Fi client blocks = live device telemetry — keep subscribed
# IOT_MATTER_TOPICS=rdk/matter/devices/list
# IOT_MATTER_CONTROL_TOPIC=rdk/matter/device/control
# IOT_MATTER_RESULT_TOPIC=rdk/matter/device/control/result
# IOT_MATTER_REFRESH_TOPIC=rdk/matter/devices/refresh
# IOT_MATTER_QUERY_CMD=UPDATE_DEVICE      # deliberate hub-firmware workaround; set CONTROL_DEVICE once hub is fixed

# ── Shelly fleet ──
# IOT_SHELLY_DEVICES=shellyplus1pm-cc7b5c844c18   # comma-separated MQTT ids
# IOT_SHELLY_REPLY_SRC=rdk/shelly/ce-server

# ── Device identity niceties ──
# IOT_MATTER_MAC_ALIASES=32768=F0:09:0D:8C:B5:7C  # nodeId=realMAC, merges Matter row with its Wi-Fi row
# IOT_DEVICE_NAMES=CC:7B:5C:84:4C:18=Coffee Brewer # MAC=friendly name overrides

# ── Persistence ──
# IT/OT operator overrides (JSON file). Default resolves RELATIVE to the
# compiled server file (server/.data/device-overrides.json) — on a deployed
# box set an absolute, writable, persistent path:
# DEVICE_OVERRIDES_PATH=/var/lib/qsr/device-overrides.json

# ── Optional: AI Insight card (/api/insight) — remove route if unused ──
# LLM_PROVIDER=bedrock
# AWS_BEARER_TOKEN_BEDROCK=bedrock-api-key-...
# AGENT_MODEL=us.anthropic.claude-haiku-4-5-20251001-v1:0
# ANTHROPIC_API_KEY=                       # alternative to Bedrock
