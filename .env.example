# Connected Enterprise local development template
# Copy to .env and fill only the credentials you need. Never commit real values.

# LLM provider: anthropic or bedrock
LLM_PROVIDER=bedrock
AGENT_MODEL=
ANTHROPIC_API_KEY=
AWS_BEARER_TOKEN_BEDROCK=
AWS_BEDROCK_API_KEY=
BEDROCK_COPILOT_MODEL_ID=

# Prefer AWS_PROFILE locally or an instance/task role in AWS. Do not place
# long-lived IAM access keys in this file.
AWS_PROFILE=
AWS_REGION=us-east-1
AWS_DEFAULT_REGION=us-east-1
AWS_USE_INSTANCE_ROLE=false
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=

# AWS IoT telemetry connection
IOT_ENDPOINT=
IOT_REGION=us-east-1
IOT_CLIENT_ID=connected-enterprise-local
IOT_IPSEC_TOPIC=rdk/ipsec/metrics
IOT_IPSEC_TOPICS=
IOT_IPSEC_DEVICE_TOPICS=
IOT_DEVICE_TOPICS=
IOT_AAR_TOPICS=
IOT_PATH_PREFIXES=
IOT_MATTER_TOPICS=
IOT_MATTER_REFRESH_TOPIC=
IOT_MATTER_RESULT_TOPIC=
IOT_MATTER_CONTROL_TOPIC=
IOT_MATTER_QUERY_CMD=
IOT_MATTER_MAC_ALIASES=
IOT_SHELLY_DEVICES=
IOT_SHELLY_REPLY_SRC=
IOT_DEVICE_NAMES=
IOT_GATEWAY_TWIN_EVENTS_TOPIC=
IOT_GATEWAY_TWIN_STATUS_TOPIC=
IOT_GATEWAY_TWIN_PRPLOS_PREFIX=
IOT_GATEWAY_TWIN_HISTORY_SIZE=500
DEVICE_OVERRIDES_PATH=

# Local server
AGENT_SERVER_PORT=3001
CORS_ALLOWED_ORIGINS=http://localhost:5174,http://127.0.0.1:5174
AGENTIC_UPSTREAM=
AGENTIC_SMART_UPSTREAM=

# Onboarding local simulator. Direct Express onboarding is deliberately
# disabled when NODE_ENV=production; production uses the Cognito-authorized API.
ONBOARDING_AUTH_MODE=development
ONBOARDING_DEV_TENANT_ID=tenant_demo
ONBOARDING_DEV_TENANT_NAME=Connected Enterprise Demo
ONBOARDING_DEV_ACTOR_ID=operator_demo
ONBOARDING_DEV_ACTOR_EMAIL=operator@example.invalid
ONBOARDING_SIMULATE_DEVICE=true
ONBOARDING_SIMULATION_STEP_MS=900

# Generate both values locally. The activation pepper hashes one-time proofs at
# rest; the status token protects the optional local device-simulator callback.
ONBOARDING_ACTIVATION_PEPPER=
ONBOARDING_DEVICE_STATUS_TOKEN=

# AWS onboarding UI (values are CloudFormation outputs from the CDK stack).
# Leave all blank to use the same-origin local simulator.
VITE_ONBOARDING_API_URL=
VITE_ONBOARDING_COGNITO_DOMAIN=
VITE_ONBOARDING_COGNITO_CLIENT_ID=
VITE_ONBOARDING_REDIRECT_URI=http://localhost:5174/onboarding
VITE_ONBOARDING_LOGOUT_URI=http://localhost:5174/onboarding
VITE_ONBOARDING_DISABLE_SSE=false
